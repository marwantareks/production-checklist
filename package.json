{
  "name": "production-readiness-checklist",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1"
  },
  "description": "A free production readiness checklist for architects, with an agent-assisted review mode for Claude Code.",
  "license": "MIT",
  "author": "Marwan Tarek",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "node scripts/build.mjs",
    "prompts": "node scripts/prompts.mjs",
    "review:export": "node scripts/export-review-pack.mjs",
    "review:apply": "node scripts/apply-review.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test tests/e2e/*.test.mjs",
    "check": "npm run validate && npm run build && npm test",
    "review:prompt": "node scripts/build-review-prompt.mjs"
  }
}
