{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "categories.schema.json",
  "title": "Categories",
  "type": "object",
  "additionalProperties": false,
  "required": ["categories"],
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "hue", "summary", "icon", "order"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 3, "maxLength": 60 },
          "hue": { "enum": ["blue", "teal", "red", "purple", "green", "coral", "pink", "amber"] },
          "summary": { "type": "string", "minLength": 10, "maxLength": 120 },
          "icon": { "type": "string", "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9 .,\\-]+$", "description": "SVG path data drawn on a 24 by 24 grid." },
          "order": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
