{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "retired.schema.json",
  "title": "Retired concerns",
  "description": "Concern ids that were retired. An id is never reused and nothing may link to it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "retired"
  ],
  "properties": {
    "retired": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "reason",
          "date"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "merged_into": {
            "type": "integer",
            "minimum": 1
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 300
          }
        }
      }
    }
  }
}
