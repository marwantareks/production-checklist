{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-findings.schema.json",
  "title": "Content review findings",
  "description": "What a third-party reviewer returns after reviewing the content pack. Read by scripts/apply-review.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer",
    "date",
    "findings",
    "no_issues_found"
  ],
  "properties": {
    "reviewer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120,
      "description": "Name of the reviewing agent or person."
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "scope": {
      "type": "string",
      "maxLength": 200
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "concern_id",
          "field",
          "severity",
          "type",
          "issue",
          "confidence"
        ],
        "properties": {
          "concern_id": {
            "type": "integer",
            "minimum": 1
          },
          "field": {
            "enum": [
              "definition",
              "how_it_works",
              "where_it_appears",
              "review_question",
              "trade_off",
              "why_it_matters",
              "red_flags",
              "good_looks_like",
              "decide_between",
              "search_hints",
              "evidence_to_request",
              "related",
              "applies_when",
              "look_for",
              "name",
              "ownership",
              "agent_check_level",
              "agent_prompt"
            ]
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor",
              "nit"
            ]
          },
          "type": {
            "enum": [
              "accuracy",
              "completeness",
              "clarity",
              "consistency",
              "safety",
              "agent-prompt",
              "bias",
              "style"
            ]
          },
          "issue": {
            "type": "string",
            "minLength": 10,
            "maxLength": 800
          },
          "suggested_edit": {
            "type": "string",
            "maxLength": 1200
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "sources": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 300
            }
          }
        }
      }
    },
    "suggested_additions": {
      "type": "array",
      "maxItems": 20,
      "description": "Concerns the reviewer thinks are missing from the checklist.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "category",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 60
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "description": "An existing category id, or a proposed new one."
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 600
          },
          "overlaps_with": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Ids of existing concerns that already cover part of this topic."
          }
        }
      }
    },
    "no_issues_found": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "description": "Concerns where every check was applied and nothing was found. Treat a reviewer's clean list as weak evidence."
    }
  }
}
