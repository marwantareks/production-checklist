{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta.schema.json",
  "title": "Site metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "url", "year", "updated"],
  "properties": {
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "url": { "type": "string", "pattern": "^https://[A-Za-z0-9.-]+(/[A-Za-z0-9._~/-]*)?$", "maxLength": 200, "description": "Canonical https address of the published page. Only URL safe characters are allowed because the build writes it into HTML attributes." },
    "year": { "type": "integer", "minimum": 2026, "maximum": 2100 },
    "updated": { "type": "string", "pattern": "^[A-Z][a-z]+ [0-9]{4}$", "description": "Month and year, for example October 2026." }
  }
}
